NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_CONTACT_EMAIL=

# Configure with the publisher ID and responsive ad-unit slots from your AdSense account.
# Ads remain disabled unless NEXT_PUBLIC_ADSENSE_ENABLED is exactly "true".
# Enable only after the production domain is approved and required privacy/consent disclosures
# and any regionally required Google-certified CMP are configured.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CONSENT_READY=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_SEARCH=
NEXT_PUBLIC_ADSENSE_SLOT_PYQS=
