MONGODB_URI=mongodb://127.0.0.1:27017/student_resource_sharing
# Optional Node.js DNS servers for local MongoDB Atlas SRV lookup failures.
# Leave unset on Render unless its default resolver cannot resolve Atlas SRV records.
# MONGODB_DNS_SERVERS=8.8.8.8
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Generate a random secret for each deployment.
JWT_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Create a key in Google AI Studio and keep it only in the backend environment.
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.5-flash-lite
GEMINI_SYLLABUS_MODEL=gemini-3.5-flash-lite
GEMINI_VERIFICATION_MODEL=gemini-3.5-flash-lite
GEMINI_TUTOR_MODEL=gemini-3.5-flash-lite
GEMINI_VERIFICATION_USE_GOOGLE_SEARCH=false
GEMINI_USER_DAILY_REQUEST_LIMIT=100
GEMINI_USER_MINUTE_REQUEST_LIMIT=30

ACADEMIC_REFERENCE_DOMAINS=openstax.org,nist.gov,mathworld.wolfram.com,chem.libretexts.org,physicsclassroom.com,khanacademy.org
MIN_VERIFIABLE_STATEMENTS=5

# Keep the existing production value unchanged; rotating it requires re-encrypting stored OCR data.
OCR_ENCRYPTION_KEY=

REWARD_BUDGET_POINTS=10000
REWARD_POINTS_HANDWRITTEN_NOTE=10
REWARD_POINTS_PYQ=8
REWARD_POINTS_VERIFIED_CORRECTION=5
REWARD_POINTS_HIGH_QUALITY_RESOURCE=15

# Set these only temporarily in backend/.env to provision the initial admin.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
